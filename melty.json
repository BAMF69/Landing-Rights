{
  "githubRepo": "BAMF69/Landing-Rights",
  "name": "Landing Rights",
  "version": "0.1.1",
  "status": "playable",
  "summary": "Fly Endless Sky; land on a planet you've claimed and build on it in Dyson Sphere Program, then ship the goods up to your fleet.",
  "players": {
    "mode": "solo"
  },
  "games": [
    {
      "slug": "endless-sky",
      "role": "host",
      "version": "0.11.2",
      "store": "steam"
    },
    {
      "slug": "dyson-sphere-program",
      "role": "companion",
      "store": "steam"
    }
  ],
  "components": [
    {
      "id": "es-build",
      "fileName": "LandingRights-*-endless-sky.zip",
      "license": "GPL-3.0-or-later",
      "install": [
        {
          "from": "Endless Sky Landing Rights.exe",
          "to": "{game}/Endless Sky Landing Rights.exe"
        },
        {
          "from": "plugins/landing-rights/",
          "to": "{game}/plugins/landing-rights/"
        }
      ]
    },
    {
      "id": "dsp-plugin",
      "fileName": "LandingRights-*-dyson-sphere-program.zip",
      "license": "MIT (plugin), LGPL-2.1 (Unity Doorstop), MIT (Mono.Cecil)",
      "install": [
        {
          "from": "winhttp.dll",
          "to": "{game:dyson-sphere-program}/winhttp.dll"
        },
        {
          "from": "doorstop_config.ini",
          "to": "{game:dyson-sphere-program}/doorstop_config.ini"
        },
        {
          "from": "LandingRights/",
          "to": "{game:dyson-sphere-program}/LandingRights/"
        }
      ]
    }
  ],
  "recipe": {
    "together": true,
    "launch": {
      "kind": "exe",
      "path": "{game}/Endless Sky Landing Rights.exe",
      "workingDirectory": "{game}",
      "note": "Starts Dyson Sphere Program through Steam (steam://rungameid/1366540) unless it is already running."
    },
    "windows": "Both full screen; focus switches to DSP when you land on a claim and back to Endless Sky when you press F8."
  }
}
